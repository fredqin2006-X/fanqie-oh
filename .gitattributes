* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.sha256 text eol=lf
*.png binary
*.webp binary
*.woff2 binary
# Preserve the imported third-party distribution's whitespace verbatim.
app/native/third_party/kissfft/** whitespace=-blank-at-eol,-blank-at-eof
